  "components": {
    "schemas": {
      "DashboardSummary": {
        "properties": {
          "seed_count": {
            "type": "integer",
            "title": "Seed Count"
          },
          "greenlit_count": {
            "type": "integer",
            "title": "Greenlit Count"
          },
          "sovereign_count": {
            "type": "integer",
            "title": "Sovereign Count"
          },
          "open_decryption_requests": {
            "type": "integer",
            "title": "Open Decryption Requests"
          },
          "open_challenges": {
            "type": "integer",
            "title": "Open Challenges"
          },
          "total_delegations": {
            "type": "integer",
            "title": "Total Delegations"
          },
          "total_reward_events": {
            "type": "integer",
            "title": "Total Reward Events"
          }
        },
        "type": "object",
        "required": [
          "seed_count",
          "greenlit_count",
          "sovereign_count",
          "open_decryption_requests",
          "open_challenges",
          "total_delegations",
          "total_reward_events"
        ],
        "title": "DashboardSummary"
      },
      "OperationalStatus": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "service",
          "version"
        ],
        "title": "OperationalStatus"
      }
    }
